          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="470" y="480" />
            <mxPoint as="targetPoint" x="570" y="320" />
            <Array as="points">
              <mxPoint x="515" y="480" />
              <mxPoint x="515" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="scope" value="TRUST BOUNDARY&#10;Service may decrypt internally.&#10;Public responses use FRD allowlists.&#10;A lender sees only participating loans." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#f7fafc;strokeColor=#235983;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=19;fontColor=#183247;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="1130" y="420" width="430" height="155" />
        </mxCell>
        <mxCell id="steps.title" value="One mutation · one connection · one atomic result" vertex="1" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=white;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=27;fontColor=#183247;fontStyle=1;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="40" y="625" width="1520" height="50" />
        </mxCell>
        <mxCell id="prepare" value="1  PREPARE / LOCK&#10;Validate actor and receipt retry.&#10;Lock Users → profile → requests&#10;→ loans → installments; capture T." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#eef5f9;strokeColor=#235983;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="40" y="710" width="450" height="170" />
        </mxCell>
        <mxCell id="decrypt" value="2  DECRYPT / AUTHENTICATE&#10;Read exact locked envelopes.&#10;Decrypt locally with field-bound AAD.&#10;Failure aborts the entire action." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#eef5f9;strokeColor=#235983;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="575" y="710" width="450" height="170" />
        </mxCell>
        <mxCell id="calculate" value="3  CALCULATE IN SQL&#10;Bound decimal inputs; current burden.&#10;Check capacity, deadline, delinquency.&#10;Return authoritative check summary." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#eef5f9;strokeColor=#235983;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="1110" y="710" width="450" height="170" />
        </mxCell>
        <mxCell id="write" value="4  WRITE + AUDIT&#10;Encrypt retained summary.&#10;Routine writes business effects.&#10;Trigger alone owns loan completion." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#eef5f9;strokeColor=#235983;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="1110" y="970" width="450" height="170" />
        </mxCell>
        <mxCell id="commit" value="5  COMMIT / RESPOND&#10;Store original financial receipt.&#10;Commit before reporting success.&#10;Exact retry returns original result." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#eef5f9;strokeColor=#235983;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="575" y="970" width="450" height="170" />
        </mxCell>
        <mxCell id="failure" value="6  ON FAILURE&#10;Whole transaction rollback.&#10;Separate failure evidence transaction.&#10;Retry transient errors at most 3 tries." vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#eef5f9;strokeColor=#235983;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="40" y="970" width="450" height="170" />
        </mxCell>
        <mxCell id="p-d" edge="1" parent="1" source="prepare" target="decrypt" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#235983;strokeWidth=2;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="490" y="795" />
            <mxPoint as="targetPoint" x="575" y="795" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d-c" edge="1" parent="1" source="decrypt" target="calculate" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#235983;strokeWidth=2;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1025" y="795" />
            <mxPoint as="targetPoint" x="1110" y="795" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c-w" edge="1" parent="1" source="calculate" target="write" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#235983;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1335" y="880" />
            <mxPoint as="targetPoint" x="1335" y="970" />
          </mxGeometry>
        </mxCell>
        <mxCell id="w-commit" edge="1" parent="1" source="write" target="commit" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#235983;strokeWidth=2;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1110" y="1055" />
            <mxPoint as="targetPoint" x="1025" y="1055" />
          </mxGeometry>
        </mxCell>
        <mxCell id="failure.branch" value="Failure branch from steps 1–5; step 6 is not executed after a confirmed successful commit." vertex="1" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=white;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="40" y="1165" width="1520" height="45" />
        </mxCell>
        <mxCell id="flow.note" value="RQ-01 uses the same lock/decrypt/calculate boundary without writing evaluation history.&#10;Other reports use one consistent snapshot and authorization scope. Session memory is operational, not another entity.&#10;Editable source + exports: Application_Design.drawio · Explanation and API contracts: TDD §2." vertex="1" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=white;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=19;fontColor=#183247;fontStyle=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="40" y="1230" width="1520" height="88" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
