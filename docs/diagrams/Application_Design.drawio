          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="805" y="435" />
            <mxPoint as="targetPoint" x="805" y="360" />
          </mxGeometry>
        </mxCell>
        <mxCell id="keys" value="INJECTED SECRETS&#10;Keys + separate runtime DB credentials&#10;Never in browser, tables or audit" vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=white;strokeColor=#235983;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="40" y="435" width="430" height="120" />
        </mxCell>
