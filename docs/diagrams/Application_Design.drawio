          <mxGeometry as="geometry" x="1046" y="202" width="140" height="36" />
        </mxCell>
        <mxCell id="worker" value="WORKER&#10;Assessment / expiry / delinquency&#10;Same coordinator, worker credential" vertex="1" parent="1" style="shape=rectangle;html=0;whiteSpace=wrap;fillColor=#eef5f9;strokeColor=#235983;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=21;fontColor=#183247;fontStyle=0;align=center;verticalAlign=middle;">
