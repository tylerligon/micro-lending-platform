        <mxCell id="o.title" value="OVERSIGHT · Administrator or read-only Auditor" vertex="1" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=#eef5f9;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=25;fontColor=#183247;fontStyle=1;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="58" y="972" width="1484" height="45" />
        </mxCell>
        <mxCell id="o.review" value="ADMINISTRATOR&#10;Review queue → authorized inputs and check results&#10;[Approve] [Reject + reason]   [Append follow-up note]&#10;Accounts → [Restrict] / role management&#10;No editing past payments, assessments or audit events." vertex="1" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=white;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="65" y="1035" width="720" height="200" />
        </mxCell>
        <mxCell id="o.audit" value="ADMINISTRATOR + AUDITOR&#10;Loan-scoped delinquency → schedule / history&#10;Monthly reports → totals over authorized records&#10;Audit history → event, actor, time, safe old/new values&#10;Auditor: no mutations or private financial inputs." vertex="1" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=white;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=20;fontColor=#183247;fontStyle=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="825" y="1035" width="700" height="200" />
        </mxCell>
        <mxCell id="o.empty" value="Every workspace needs loading, empty, validation, denial, success and unknown-outcome states.&#10;Buttons do not enforce permission: API + routines do. Label repayments as loan progress, never lender payouts." vertex="1" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=white;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=18;fontColor=#183247;fontStyle=0;align=left;verticalAlign=middle;">
          <mxGeometry as="geometry" x="65" y="1260" width="1450" height="65" />
        </mxCell>
        <mxCell id="ui.footer" value="Money is fictional and interest-free. UTC timestamps / calendar due dates. No wallet, payment provider or disbursement screen.&#10;Editable source + exports: Application_Design.drawio · API/session/field contracts: TDD §2.2." vertex="1" parent="1" style="shape=text;html=0;whiteSpace=wrap;fillColor=white;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=19;fontColor=#183247;fontStyle=0;align=left;verticalAlign=middle;">
