        <mxCell id="funding.notes.text" value="Profile = current values. Request = frozen submitted values. Evaluation = one retained check.&#10;Receipt = caller-scoped exact retry. Commitment = one contribution, including repeat lender contributions.&#10;Dashed cards are named references, not entities. Full constraints: TDD §4, §6–8. Audit catalogue: §8.1." style="shape=text;whiteSpace=wrap;html=0;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=18;fontColor=#183247;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1">
