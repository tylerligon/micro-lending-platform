        <mxCell id="c.attr.comp.note" value="Composite identifier maps to two PK columns.&#10;Role ovals are notation, not a stored list.&#10;Dashed oval = derived; underlined oval = key." style="shape=text;whiteSpace=wrap;html=0;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=17;fontColor=#183247;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815" y="1605" width="500" height="98" />
        </mxCell>
        <mxCell id="c.legend.text" value="Rectangles: entities · diamonds: relationships&#10;Double rectangle + diamond: weak / identifying&#10;Double line: total participation · single: partial&#10;(min,max) at an entity: its participation count&#10;&#10;The 3-or-6 schedule minimum is transactional.&#10;Page 2–3 FK cards state both directions explicitly.&#10;All 15 entities and 114 attributes are defined there." style="shape=text;whiteSpace=wrap;html=0;rounded=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontFamily=DejaVu Sans;fontSize=19;fontColor=#183247;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1370" y="1390" width="740" height="290" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
